let S={rows:[],tab:'bal',store:'',q:'',lq:'',type:'in',del:-1};
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt=n=>Number(n||0).toLocaleString('en-US',{maximumFractionDigits:2});
function seed(){return SEED.R.map(x=>({d:x[0],i:SEED.I[x[1]],s:x[2],w:x[3],u:x[4],a:x[5],o:x[6],n:x[7],c:x[8],t:x[9]}))}
function load(){let v=null;try{v=localStorage.getItem(KEY)}catch(e){}S.rows=v?JSON.parse(v):seed()}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S.rows))}catch(e){toast('تعذر الحفظ على الجهاز')}}
function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';setTimeout(()=>e.style.display='none',2500)}

/* نفس معادلات الشيت */
function calc(){
  const m=new Map();
  const rows=S.rows.map((r,idx)=>{
    let k=m.get(r.i);if(!k){k={q:0,v:0};m.set(r.i,k)}
    const a=+r.a||0,o=+r.o||0;let pi=0,ci=0,po=0,co=0;
    if(a>0){ci=+r.c||0;pi=ci/a}                 // سعر الوارد = التكلفة ÷ الكمية
    if(o>0){po=k.q?k.v/k.q:0;co=po*o}           // سعر المنصرف = متوسط مرجح للرصيد السابق
    k.q+=a-o;k.v+=ci-co;                         // الرصيد بالكمية والقيمة تراكمي لكل صنف
    return{...r,idx,m:+(r.d||'').slice(5,7),a,o,pi,ci,po,co,bq:k.q,bv:k.v};
  });
  const items=new Map();
  rows.forEach(r=>items.set(r.i,{n:r.i,q:r.bq,v:r.bv,w:r.w||(items.get(r.i)||{}).w,u:r.u||(items.get(r.i)||{}).u,s:r.s}));
  return{rows,items};
}
let C;
function refresh(){C=calc();let t=0;C.items.forEach(x=>t+=x.v);$('#tot').innerHTML=fmt(t)+' <small>ج.م</small>';draw()}

const TABS=[['bal','الأرصدة'],['new','حركة جديدة'],['log','السجل'],['data','البيانات']];
function draw(){
  $('#nav').innerHTML=TABS.map(([k,n])=>`<button class="${S.tab==k?'on':''}" onclick="S.tab='${k}';S.del=-1;draw()">${n}</button>`).join('');
  ({bal:vBal,new:vNew,log:vLog,data:vData})[S.tab]();
}

function vBal(){
  let L=[...C.items.values()].filter(x=>(!S.store||x.w==S.store)&&(!S.q||x.n.includes(S.q))&&(x.q||x.v));
  L.sort((a,b)=>b.v-a.v);
  $('#main').innerHTML=`<input id="q" placeholder="ابحث عن صنف" value="${esc(S.q)}">
  <div class="chips">${[['','الكل'],['خامات','خامات'],['عبوات','عبوات']].map(([v,n])=>`<button class="${S.store==v?'on':''}" onclick="S.store='${v}';draw()">${n}</button>`).join('')}</div>`+
  (L.length?L.slice(0,150).map(x=>`<div class="it" onclick="S.lq='${esc(x.n).replace(/'/g,"\\'")}';S.tab='log';draw()"><div class="t">${esc(x.n)}</div>
  <div class="m"><span class="${x.q<0?'warn':''}">${fmt(x.q)} ${esc(x.u||'')}</span><span>${fmt(x.v)} ج.م</span><span>متوسط ${fmt(x.q?x.v/x.q:0)}</span></div></div>`).join(''):'<div class="empty">لا توجد أصناف. استورد ملف الإكسل من تبويب البيانات أو أضف حركة جديدة.</div>');
  $('#q').oninput=e=>{S.q=e.target.value;const p=e.target.selectionStart;vBal();const n=$('#q');n.focus();n.setSelectionRange(p,p)};
}

function vLog(){
  const q=S.lq;
  let L=C.rows.filter(r=>!q||r.i.includes(q)||String(r.n||'').includes(q)||(r.s||'').includes(q)).reverse().slice(0,80);
  $('#main').innerHTML=`<input id="lq" placeholder="صنف أو رقم مستند أو مورد" value="${esc(q)}">`+
  (L.length?L.map(r=>`<div class="it"><div class="t">${esc(r.i)}</div>
  <div class="m"><span>${esc(r.d)}</span><span class="${r.a>0?'in':'out'}">${r.a>0?'وارد '+fmt(r.a):'منصرف '+fmt(r.o)}</span><span>سعر ${fmt(r.a>0?r.pi:r.po)}</span></div>
  <div class="m"><span>التكلفة ${fmt(r.a>0?r.ci:r.co)}</span><span>الرصيد ${fmt(r.bq)}</span><span>${fmt(r.bv)} ج.م</span></div>
  <div class="m"><span>${esc(r.s||'')} ${r.n?'· مستند '+esc(r.n):''}</span><button class="btn g" style="width:auto;padding:4px 12px;margin:0" onclick="del(${r.idx})">${S.del==r.idx?'تأكيد الحذف':'حذف'}</button></div></div>`).join(''):'<div class="empty">لا توجد حركات</div>');
  $('#lq').oninput=e=>{S.lq=e.target.value;const p=e.target.selectionStart;vLog();const n=$('#lq');n.focus();n.setSelectionRange(p,p)};
}
function del(i){if(S.del!=i){S.del=i;draw();return}S.rows.splice(i,1);S.del=-1;save();refresh();toast('تم الحذف')}

function vNew(){
  const t=S.type,today=new Date().toISOString().slice(0,10);
  $('#main').innerHTML=`<div class="seg"><button class="i ${t=='in'?'on':''}" onclick="S.type='in';draw()">وارد</button><button class="o ${t=='out'?'on':''}" onclick="S.type='out';draw()">منصرف</button></div>
  <label>التاريخ</label><input type="date" id="fd" value="${today}">
  <label>اسم الصنف</label><input id="fi" list="dl" autocomplete="off"><datalist id="dl">${[...C.items.keys()].map(k=>`<option value="${esc(k)}">`).join('')}</datalist>
  ${t=='in'?'<label>اسم المورد</label><input id="fs">':''}
  <div class="row"><div><label>المخزن</label><select id="fw"><option>خامات</option><option>عبوات</option></select></div><div><label>الوحدة</label><select id="fu"><option>كيلو</option><option>عدد</option></select></div></div>
  <div class="row"><div><label>الكمية</label><input id="fq" type="number" inputmode="decimal"></div><div><label>رقم المستند</label><input id="fn"></div></div>
  ${t=='in'?'<div class="row"><div><label>سعر الوحدة</label><input id="fp" type="number" inputmode="decimal"></div><div><label>التكلفة الإجمالية</label><input id="fc" type="number" inputmode="decimal"></div></div>':'<div class="pv" id="pv">اختر الصنف والكمية</div>'}
  <label>ملاحظات</label><input id="ft"><button class="btn" onclick="add()">حفظ الحركة</button>`;
  const pv=()=>{
    const it=C.items.get($('#fi').value);
    if(it){$('#fw').value=it.w||'خامات';$('#fu').value=it.u||'كيلو'}
    if(t=='out'&&$('#pv')){
      const q=+$('#fq').value||0,avg=it&&it.q?it.v/it.q:0;
      $('#pv').innerHTML=it?`الرصيد ${fmt(it.q)} · متوسط السعر ${fmt(avg)} · التكلفة ${fmt(avg*q)}`+(q>it.q?'<div class="warn">الكمية أكبر من الرصيد</div>':''):'صنف جديد، لا يوجد رصيد';
    }
  };
  ['fi','fq'].forEach(id=>$('#'+id).oninput=pv);
  if(t=='in'){$('#fp').oninput=()=>{const q=+$('#fq').value;if(q)$('#fc').value=+(($('#fp').value||0)*q).toFixed(3)};$('#fc').oninput=()=>{const q=+$('#fq').value;if(q)$('#fp').value=+(($('#fc').value||0)/q).toFixed(4)}}
}
function add(){
  const i=$('#fi').value,q=+$('#fq').value,t=S.type;
  if(!i||!(q>0)){toast('اكتب الصنف والكمية');return}
  let c=0;if(t=='in'){c=+$('#fc').value||(+$('#fp').value||0)*q;if(!c)toast('لم تكتب سعرًا، التكلفة ستكون صفرًا')}
  S.rows.push({d:$('#fd').value,i,s:t=='in'?$('#fs').value:'',w:$('#fw').value,u:$('#fu').value,a:t=='in'?q:0,o:t=='out'?q:0,n:$('#fn').value,c,t:$('#ft').value});
  save();refresh();S.tab='bal';draw();toast('تم الحفظ')
}

function vData(){
  $('#main').innerHTML=`<div class="it"><div class="t">استيراد من ملف الإكسل</div><div class="m">اختر ملف بيانات ٢٠٢٦ وسيُقرأ منه تبويب «مخزن». سيحل محل البيانات الحالية.</div><input type="file" id="fx" accept=".xlsx,.xls"></div>
  <div class="it"><div class="t">نسخة نصية (CSV)</div><button class="btn g" onclick="exp()">إنشاء النص</button><textarea id="ex" rows="5" readonly></textarea></div>
  <div class="it"><div class="t">عدد الحركات: ${S.rows.length}</div><button class="btn g" onclick="wipe()">${S.del==-2?'تأكيد الرجوع للبيانات الأصلية':'الرجوع للبيانات الأصلية'}</button></div>`;
  $('#fx').onchange=e=>e.target.files[0]&&imp(e.target.files[0]);
}
function wipe(){if(S.del!=-2){S.del=-2;draw();return}S.rows=seed();S.del=-1;save();refresh();toast('رجعت البيانات الأصلية')}
function exp(){
  const h='الشهر,التاريخ,الصنف,المورد,المخزن,الوحدة,وارد,منصرف,الرصيد,المستند,سعر وارد,تكلفة وارد,سعر منصرف,تكلفة منصرف,رصيد بالقيمة';
  $('#ex').value=[h,...C.rows.map(r=>[r.m,r.d,r.i,r.s,r.w,r.u,r.a,r.o,r.bq,r.n,r.pi,r.ci,r.po,r.co,r.bv].map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(','))].join('\n');
  $('#ex').select();
}
const ser=n=>new Date(Math.round((n-25569)*864e5)).toISOString().slice(0,10);
async function imp(f){
  try{
    const wb=XLSX.read(await f.arrayBuffer(),{type:'array'});
    const ws=wb.Sheets['مخزن'];if(!ws){toast('لم أجد تبويب اسمه مخزن');return}
    const A=XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:null});
    const out=[];
    for(let i=1;i<A.length;i++){
      const r=A[i];if(!r[2]||typeof r[1]!='number')continue;
      const a=+r[6]||0,o=+r[7]||0;if(!a&&!o)continue;
      const nm=String(r[2]);
      out.push({d:ser(r[1]),i:nm,s:r[3]||'',w:r[4]||'',u:r[5]||(nm.includes('كيلو')?'كيلو':'عدد'),a,o,n:r[9]??'',c:a>0?(+r[11]||(+r[10]||0)*a):0,t:r[15]||''});
    }
    S.rows=out;save();refresh();toast('تم استيراد '+out.length+' حركة');S.tab='bal';draw();
  }catch(e){toast('تعذر قراءة الملف')}
}
load();refresh();
