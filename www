<style>
:root{--bg:#eef2f4;--card:#fff;--ink:#14232b;--mut:#5d6f78;--line:#d5dde1;--acc:#f2b705;--in:#1b7f4b;--out:#c0392b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a20;--card:#17262e;--ink:#e8eef1;--mut:#92a6af;--line:#2a3c46;--in:#4cc38a;--out:#ff7b6b}}
:root[data-theme="dark"]{--bg:#0f1a20;--card:#17262e;--ink:#e8eef1;--mut:#92a6af;--line:#2a3c46;--in:#4cc38a;--out:#ff7b6b}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font:15px/1.5 Tajawal,system-ui,sans-serif}
header{padding:14px 16px 10px;background:var(--card);border-bottom:1px solid var(--line)}
header b{font-size:13px;color:var(--mut);font-weight:500}
header .tot{font-size:26px;font-weight:700}
header .tot small{font-size:13px;color:var(--mut);font-weight:400}
main{flex:1;overflow-y:auto;padding:12px 14px}
nav{display:flex;background:var(--card);border-top:1px solid var(--line)}
nav button{flex:1;padding:12px 4px;border:0;background:none;color:var(--mut);font:inherit;font-weight:500}
nav button.on{color:var(--ink);box-shadow:inset 0 3px 0 var(--acc);font-weight:700}
input,select,textarea{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);font:inherit;margin:4px 0 10px}
label{font-size:13px;color:var(--mut)}
.row{display:flex;gap:8px}.row>*{flex:1}
.chips{display:flex;gap:6px;margin-bottom:10px}
.chips button{padding:6px 14px;border-radius:99px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit}
.chips button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.it{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px}
.it .t{font-weight:500;word-break:break-word}
.it .m{display:flex;justify-content:space-between;gap:8px;color:var(--mut);font-size:13px;margin-top:4px}
.in{color:var(--in);font-weight:700}.out{color:var(--out);font-weight:700}
.btn{width:100%;padding:13px;border:0;border-radius:10px;background:var(--acc);color:#14232b;font:inherit;font-weight:700;margin-top:4px}
.btn.g{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.seg{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:12px}
.seg button{flex:1;padding:11px;border:0;background:var(--card);color:var(--ink);font:inherit;font-weight:700}
.seg button.on.i{background:var(--in);color:#fff}.seg button.on.o{background:var(--out);color:#fff}
.pv{padding:10px;border-radius:8px;background:var(--bg);border:1px dashed var(--line);margin-bottom:10px;font-size:14px}
.warn{color:var(--out);font-weight:700}
.empty{text-align:center;color:var(--mut);padding:40px 10px}
#toast{position:fixed;inset:auto 16px 80px;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:8px;text-align:center;display:none}
</style>
</head>
